<view class="game-page">
  <view class="hud" wx:if="{{gameState === 'playing'}}">
    <view class="stat-box">
      <text class="stat-label">分数</text>
      <text class="stat-value">{{score}}</text>
    </view>
    <view class="stat-box">
      <text class="stat-label">关卡</text>
      <text class="stat-value">{{level}}</text>
    </view>
    <view class="stat-box">
      <text class="stat-label">目标</text>
      <text class="stat-value">{{target}}</text>
    </view>
    <view class="stat-box">
      <text class="stat-label">步数</text>
      <text class="stat-value">{{moves}}</text>
    </view>
  </view>

  <game-canvas bind:ready="onCanvasReady" />

  <view class="level-toast" wx:if="{{showToast}}">
    <text class="toast-text">{{toastText}}</text>
  </view>

  <view class="overlay" wx:if="{{gameState === 'idle'}}">
    <text class="overlay-title">消消乐</text>
    <text class="overlay-sub">交换相邻宝石，三个以上消除得分</text>
    <button class="btn-primary" bindtap="onStartGame">开始游戏</button>
  </view>

  <game-over
    visible="{{gameState === 'over'}}"
    score="{{score}}"
    best="{{best}}"
    is-new-record="{{isNewRecord}}"
    bind:retry="onStartGame"
  />
</view>
