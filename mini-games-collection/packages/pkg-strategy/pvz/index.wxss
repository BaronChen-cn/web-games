.game-page {
  position: relative;
  width: 100%;
  height: 100vh;
  overflow: hidden;
  background: #0a1a05;
}

/* ========== HUD ========== */
.hud {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 16rpx;
  background: rgba(0, 20, 0, 0.85);
  z-index: 10;
}

.hud-left {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.sun-icon {
  font-size: 32rpx;
}

.sun-count {
  font-size: 28rpx;
  font-weight: 700;
  color: #ffe94d;
}

.hud-center {
  flex: 1;
  text-align: center;
  padding: 0 16rpx;
}

.wave-label {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.7);
  display: block;
  margin-bottom: 4rpx;
}

.wave-bar-bg {
  width: 100%;
  height: 8rpx;
  background: rgba(255, 255, 255, 0.15);
  border-radius: 4rpx;
  overflow: hidden;
}

.wave-bar-fill {
  height: 100%;
  background: linear-gradient(90deg, #39ff14, #66ff44);
  border-radius: 4rpx;
  transition: width 0.3s;
}

.hud-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.level-label {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.7);
}

.lives-row {
  display: flex;
  gap: 4rpx;
}

.life-icon {
  font-size: 24rpx;
}

/* ========== CARD PANEL ========== */
.card-panel {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 160rpx;
  white-space: nowrap;
  background: rgba(0, 20, 0, 0.9);
  border-top: 2rpx solid rgba(57, 255, 20, 0.3);
  z-index: 10;
  padding: 8rpx 12rpx;
}

.plant-card {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  width: 120rpx;
  height: 140rpx;
  margin-right: 12rpx;
  border-radius: 12rpx;
  border: 2rpx solid rgba(57, 255, 20, 0.4);
  background: rgba(20, 40, 15, 0.9);
  position: relative;
  overflow: hidden;
  vertical-align: top;
}

.plant-card.selected {
  border-color: #39ff14;
  box-shadow: 0 0 12rpx rgba(57, 255, 20, 0.6);
  background: rgba(30, 60, 20, 0.95);
}

.plant-card.disabled {
  opacity: 0.45;
}

.card-icon {
  width: 60rpx;
  height: 60rpx;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  margin-top: 8rpx;
}

.card-name {
  font-size: 18rpx;
  color: #ccc;
  margin-top: 4rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 110rpx;
}

.card-cost {
  font-size: 18rpx;
  color: #ffe94d;
  font-weight: 600;
}

.cooldown-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: rgba(0, 0, 0, 0.65);
  pointer-events: none;
}

/* ========== OVERLAYS ========== */
.overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: rgba(5, 15, 5, 0.92);
  z-index: 20;
  padding: 40rpx;
}

.overlay-title {
  font-size: 56rpx;
  font-weight: 900;
  color: #39ff14;
  margin-bottom: 16rpx;
}

.title-gold {
  color: #f5e200;
}

.title-red {
  color: #ff4444;
}

.overlay-sub {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-bottom: 12rpx;
  text-align: center;
}

.overlay-desc {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
  margin-bottom: 8rpx;
  text-align: center;
}

.overlay-info {
  font-size: 22rpx;
  color: rgba(57, 255, 20, 0.7);
  margin-bottom: 32rpx;
}

.overlay-score {
  font-size: 28rpx;
  color: #ffe94d;
  margin-bottom: 24rpx;
}

.btn-primary {
  padding: 20rpx 80rpx;
  border-radius: 50rpx;
  border: none;
  font-size: 32rpx;
  font-weight: 700;
  background: linear-gradient(135deg, #39ff14, #22aa00);
  color: #fff;
  margin-bottom: 16rpx;
}

.btn-secondary {
  padding: 16rpx 60rpx;
  border-radius: 50rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.3);
  font-size: 28rpx;
  font-weight: 600;
  background: transparent;
  color: rgba(255, 255, 255, 0.7);
}
