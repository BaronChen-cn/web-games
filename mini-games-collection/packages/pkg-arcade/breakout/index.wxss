.game-page {
  position: relative;
  width: 100%;
  height: 100vh;
  overflow: hidden;
}

.hud {
  position: absolute;
  top: 10px;
  left: 0;
  right: 0;
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 16px;
  z-index: 10;
  pointer-events: none;
}

.stat-box {
  text-align: center;
}

.stat-label {
  font-size: 10px;
  color: rgba(255,255,255,0.4);
  letter-spacing: 2px;
  display: block;
}

.stat-value {
  font-size: 22px;
  font-weight: 700;
  color: #fff;
  text-shadow: 0 0 12px rgba(255,107,53,0.6);
  display: block;
}

.lives-value {
  color: #ff6b35;
}

.pause-btn {
  position: absolute;
  right: 16px;
  top: 0;
  width: 36px;
  height: 36px;
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: auto;
}

.pause-icon {
  font-size: 20px;
  color: rgba(255,255,255,0.7);
}

.overlay {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: rgba(7,8,15,0.88);
  z-index: 20;
}

.overlay-title {
  font-size: 44px;
  font-weight: 900;
  color: #ff6b35;
  margin-bottom: 8px;
}

.overlay-sub {
  font-size: 14px;
  color: #6b7280;
  margin-bottom: 24px;
}

.btn-primary {
  padding: 14px 48px;
  border-radius: 50px;
  border: none;
  font-size: 18px;
  font-weight: 700;
  background: linear-gradient(135deg, #ff6b35, #ffd700);
  color: #07080f;
}
