.game-page {
  position: relative;
  width: 100%;
  height: 100vh;
  overflow: hidden;
  background: #1a0a2e;
}

.hud {
  position: absolute;
  top: 10px;
  left: 0;
  right: 0;
  display: flex;
  justify-content: center;
  gap: 16px;
  z-index: 10;
  pointer-events: none;
}

.stat-box {
  text-align: center;
}

.stat-label {
  font-size: 10px;
  color: rgba(255,255,255,0.4);
  letter-spacing: 2px;
  display: block;
}

.stat-value {
  font-size: 24px;
  font-weight: 700;
  color: #fff;
  text-shadow: 0 0 12px rgba(57,255,20,0.6);
  display: block;
}

.stat-value.lives {
  color: #ff4444;
  text-shadow: 0 0 8px rgba(255,68,68,0.6);
}

.stat-value.combo {
  color: #ffd700;
  text-shadow: 0 0 8px rgba(255,215,0,0.6);
}

.overlay {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: rgba(26,10,46,0.92);
  z-index: 20;
}

.overlay-title {
  font-size: 48px;
  font-weight: 900;
  color: #39ff14;
  text-shadow: 0 0 20px rgba(57,255,20,0.8);
  margin-bottom: 8px;
}

.overlay-sub {
  font-size: 14px;
  color: #6b7280;
  margin-bottom: 24px;
}

.btn-primary {
  padding: 14px 48px;
  border-radius: 50px;
  border: none;
  font-size: 18px;
  font-weight: 700;
  background: linear-gradient(135deg, #39ff14, #ffd700);
  color: #1a0a2e;
}
